<Window x:Class="WuWaFpsUnlock.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鸣潮 FPS Unlock · 发现更新" Width="600" SizeToContent="Manual" MinWidth="480" MinHeight="400" MaxHeight="560"
        Style="{StaticResource WindowFrame}" Icon="Assets/App.ico" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid x:Name="DialogLayout" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,12,12"><TextBlock x:Name="ReleaseTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis"/><TextBlock Text="更新说明" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
        <TextBox x:Name="ReleaseNotes" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Padding="12"/>
        <StackPanel x:Name="ActionFooter" Grid.Row="2" Margin="0,14,0,0">
            <CheckBox x:Name="SkipVersion" Content="跳过这个版本（仍会检查后续版本）"/>
            <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0"><TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}"/></ScrollViewer>
            <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,7,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
            <Button x:Name="AfterGameButton" Content="本次游玩后帮我更新" Click="AfterGame_Click" Margin="0,12,0,0" ToolTip="本次游玩结束后保留启动器并开始更新；本次退出启动器会取消预约。"/>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="InstallButton" Content="立即更新" Style="{StaticResource PrimaryButton}" Click="Install_Click"/><Button x:Name="LaterButton" Grid.Column="2" Content="暂不更新" Click="Later_Click"/></Grid>
        </StackPanel>
    </Grid>
</Window>
