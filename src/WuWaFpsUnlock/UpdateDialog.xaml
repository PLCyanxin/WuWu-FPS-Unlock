<Window x:Class="WuWaFpsUnlock.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鸣潮 FPS Unlock · 发现更新" Width="640" Height="520" MinWidth="480" MinHeight="380"
        Style="{StaticResource WindowFrame}" Icon="Assets/App.ico" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="ReleaseTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="更新说明" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
        <TextBox x:Name="ReleaseNotes" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12"/>
        <CheckBox x:Name="SkipVersion" Grid.Row="4" Content="跳过这个版本（仍会检查后续版本）"/>
        <StackPanel Grid.Row="6"><TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}"/><ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,7,0,0" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel>
        <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="InstallButton" Content="立即更新" Style="{StaticResource PrimaryButton}" Click="Install_Click"/><Button x:Name="LaterButton" Grid.Column="2" Content="暂不更新" Click="Later_Click"/></Grid>
    </Grid>
</Window>
