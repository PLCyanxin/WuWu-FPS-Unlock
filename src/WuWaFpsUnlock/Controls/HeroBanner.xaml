<UserControl x:Class="WuWaFpsUnlock.Controls.HeroBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="96" ClipToBounds="True" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
  <Grid x:Name="BannerLayout" Background="Transparent" Margin="14,8">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="AvatarColumn" Width="70"/><ColumnDefinition x:Name="AvatarGap" Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="AvatarFrame" CornerRadius="8" Width="66" Height="66" VerticalAlignment="Center"><Image Source="/WuWaFpsUnlock;component/Assets/Icon.original.jpg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="TitleLabel" Text="鸣潮 FPS Unlock" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="VersionLabel" FontSize="15" Margin="10,4,0,0" Foreground="#C2D1E6"/></StackPanel>
      <TextBlock x:Name="DescriptionLabel" Text="为40系显卡解锁帧率并提供多帧生成" Margin="0,4,0,0" Foreground="#DCE7F5" FontSize="12"/>
    </StackPanel>
  </Grid>
</UserControl>

