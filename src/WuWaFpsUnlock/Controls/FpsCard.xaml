<UserControl x:Class="WuWaFpsUnlock.Controls.FpsCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WuWaFpsUnlock.Controls">
<Border Style="{StaticResource Card}"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="40"/><RowDefinition Height="8"/><RowDefinition Height="24"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
<Viewbox Width="36" Height="36" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3,7 L10,7 M2,12 L8,12 M3,17 L10,17 M13,6 L19,12 L13,18" Stroke="{StaticResource Blue}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="解锁帧率上限" Style="{StaticResource SectionTitle}"/><TextBlock Text="开启后下一次启动生效" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
<CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding FpsEnabled}" IsEnabled="{Binding CanChangeFpsMode}" AutomationProperties.Name="解锁帧率上限" ToolTip="FPS 开关及目标值在下次启动生效；未验证实时调帧接口。"/>
</Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions><TextBlock Text="目标帧率 (FPS)" FontSize="15"/>
<Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
<TextBox Text="{Binding FpsInput,UpdateSourceTrigger=PropertyChanged}" FontSize="16" IsEnabled="{Binding CanEditFps}" AutomationProperties.Name="目标帧率" ToolTip="30–420；240 是上限设置，不代表实测帧率。"/>
<StackPanel Grid.Column="1"><Button Content="⌃" Height="20" MinHeight="0" Padding="0" Command="{Binding IncrementFpsCommand}" IsEnabled="{Binding CanEditFps}"/><Button Content="⌄" Height="20" MinHeight="0" Padding="0" Command="{Binding DecrementFpsCommand}" IsEnabled="{Binding CanEditFps}"/></StackPanel></Grid></Grid>
<Slider Grid.Row="4" Value="{Binding TargetFps,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditFps}" AutomationProperties.Name="目标帧率滑块"/>
</Grid></Border></UserControl>



