<Window x:Class="WuWaFpsUnlock.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WuWaFpsUnlock.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="鸣潮 FPS Unlock · 设置" Width="1160" Height="806" MinWidth="850" MinHeight="600" Style="{StaticResource WindowFrame}" WindowStyle="None" ResizeMode="CanResize" Icon="Assets/App.ico" WindowStartupLocation="CenterScreen">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Background="#F7FAFF"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="14,0,0,0"><Image Source="Assets/Icon.transparent.png" Width="23" Height="23" Stretch="Uniform"/><TextBlock Text="鸣潮 FPS Unlock　设置" Margin="8,0,0,0" FontWeight="SemiBold"/><TextBlock Text="v1.2RC" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="最小化"><local:IconView Kind="minus" Width="17" Height="17"/></Button><Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="最大化"><local:IconView Kind="max" Width="16" Height="16"/></Button><Button Style="{StaticResource CaptionButton}" Click="Close_Click" AutomationProperties.Name="关闭设置"><local:IconView Kind="close" Width="18" Height="18"/></Button></StackPanel></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,8,14,12">
<local:HeroBanner Height="94"/>
<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="178"/><RowDefinition Height="12"/><RowDefinition Height="284"/></Grid.RowDefinitions>
<Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="38"/><RowDefinition Height="10"/><RowDefinition Height="38"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal"><local:IconView Kind="game" Width="27" Height="27" Margin="0,0,12,0"/><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="游戏路径" Style="{StaticResource SectionTitle}"/><Button Content="{Binding FindGameLabel}" Command="{Binding FindGameCommand}" Margin="16,0,0,0" Padding="7,2" MinHeight="24" FontSize="12"/></StackPanel><TextBlock Text="手动选择鸣潮目录与真正的游戏 EXE" Style="{StaticResource MutedText}" Margin="0,3,0,0"/></StackPanel></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><TextBlock Text="游戏目录"/><TextBox Grid.Column="1" Text="{Binding GameRoot,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSettings}" ToolTip="{Binding GameRoot}"/><Button Grid.Column="3" Command="{Binding BrowseDirectoryCommand}"><StackPanel Orientation="Horizontal"><local:IconView Kind="folder" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="浏览"/></StackPanel></Button></Grid>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><TextBlock Text="游戏 EXE"/><TextBox Grid.Column="1" Text="{Binding GameExe,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSettings}" ToolTip="{Binding GameExe}"/><Button Grid.Column="3" Command="{Binding BrowseExeCommand}"><StackPanel Orientation="Horizontal"><local:IconView Kind="file" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="选择"/></StackPanel></Button></Grid>
</Grid></Border>
<Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><local:IconView Kind="monitor" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock Text="环境信息" Style="{StaticResource SectionTitle}"/></StackPanel><Button HorizontalAlignment="Right" Command="{Binding RefreshCommand}" Background="Transparent" BorderThickness="0" Padding="4" MinHeight="0" ToolTip="重新读取环境信息"><StackPanel Orientation="Horizontal"><local:IconView Kind="refresh" Width="17" Height="17" Stroke="{StaticResource Blue}"/><TextBlock Text="重新检测" Foreground="{StaticResource Blue}" Margin="6,0,0,0"/></StackPanel></Button></Grid>
<Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="41"/><RowDefinition Height="41"/><RowDefinition Height="41"/><RowDefinition Height="41"/><RowDefinition Height="46"/></Grid.RowDefinitions>
<local:IconView Kind="gpu" Width="18" Height="18"/><TextBlock Grid.Column="1" Text="显卡"/><TextBlock Grid.Column="2" Text="{Binding Gpu}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Gpu}"/>
<local:IconView Grid.Row="1" Kind="settings" Width="18" Height="18"/><TextBlock Grid.Row="1" Grid.Column="1" Text="驱动版本"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Driver}"/>
<local:IconView Grid.Row="2" Kind="windows" Width="18" Height="18"/><TextBlock Grid.Row="2" Grid.Column="1" Text="操作系统"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Os}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Os}"/>
<local:IconView Grid.Row="3" Kind="gpu" Width="18" Height="18"/><TextBlock Grid.Row="3" Grid.Column="1" Text="HAGS"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Hags}" FontSize="12" TextWrapping="Wrap"/>
<local:IconView Grid.Row="4" Kind="frames" Width="18" Height="18"/><TextBlock Grid.Row="4" Grid.Column="1" Text="ReShade"/><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ReShadeStatus}" FontSize="12" TextWrapping="Wrap" ToolTip="本体由开始部署自动安装或复用，不另装一套。"/>
</Grid></Grid></Border>
</Grid>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="166"/><RowDefinition Height="12"/><RowDefinition Height="174"/><RowDefinition Height="12"/><RowDefinition Height="110"/></Grid.RowDefinitions>
<local:FpsCard/>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><local:IconView Kind="frames" Width="32" Height="32" Stroke="{StaticResource Blue}"/><StackPanel Grid.Column="1"><TextBlock Text="多帧生成部署" Style="{StaticResource SectionTitle}"/><TextBlock Text="Fixed 与 Dynamic 共用组件，按条件配置" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding MfgSelected}" IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="选择多帧生成部署" ToolTip="选择下一次部署的内容。关闭此选项不会卸载已安装插件；卸载使用清除插件。"/></Grid>
<Border Grid.Row="2" Background="{Binding DynamicBackground}" CornerRadius="7" Padding="10,5"><StackPanel><TextBlock Text="{Binding DynamicStatus}" Foreground="{Binding DynamicForeground}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DynamicStatus}"/><TextBlock Text="{Binding DynamicDetail}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DynamicDetail}" Margin="0,2,0,0"/></StackPanel></Border>
<StackPanel Grid.Row="4">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Dynamic 最大倍率"/><ComboBox x:Name="DynamicMaxMultiplierBox" Grid.Column="1" ItemsSource="{Binding DynamicMaxMultiplierOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DynamicMaxMultiplier,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditDynamicMultiplier}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DynamicMultiplierHint}" MinHeight="30" Padding="10,5" VerticalContentAlignment="Center" Background="#FCFDFF" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1" AutomationProperties.Name="Dynamic 最大倍率"/></Grid>


</StackPanel>
</Grid></Border>
<Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10"><Grid><Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="25"/><RowDefinition Height="4"/><RowDefinition Height="36"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><local:IconView Kind="settings" Width="21" Height="21" Margin="0,0,10,0"/><TextBlock Text="部署与维护" Style="{StaticResource SectionTitle}"/></StackPanel><CheckBox Grid.Column="1" Content="启动时自动检查更新" IsChecked="{Binding AutoCheckUpdates}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" ToolTip="{Binding UpdateStatus}"/></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DeploymentState}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageStatus}" Margin="0,0,8,0"/><Button Grid.Column="1" Content="{Binding UpdateCheckLabel}" Command="{Binding CheckUpdatesCommand}" ToolTip="{Binding UpdateStatus}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blue}" FontSize="12" Padding="4,0" MinHeight="0"/></Grid>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Button Style="{StaticResource PrimaryButton}" Command="{Binding DeployCommand}" Padding="4,5"><TextBlock Text="{Binding DeployLabel}"/></Button>
<Button x:Name="RollbackButton" Grid.Column="2" Command="{Binding RollbackVersionCommand}" Padding="4,5" ToolTip="{Binding RollbackStatus}" ToolTipService.ShowOnDisabled="True"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FFF1DD"/><Setter Property="Foreground" Value="#885C17"/><Setter Property="BorderBrush" Value="#E6CCA3"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E9EDF2"/><Setter Property="Foreground" Value="#87909C"/><Setter Property="BorderBrush" Value="#D6DCE4"/></Trigger></Style.Triggers></Style></Button.Style><TextBlock Text="回退版本"/></Button>
<Button Grid.Column="4" Command="{Binding CleanCommand}" Padding="4,5"><TextBlock Text="清除插件"/></Button>
</Grid>
</Grid></Border>
</Grid></Grid>
<Border Style="{StaticResource Card}" Margin="0,12,0,0" Height="136" Padding="12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><local:IconView Kind="file" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"/></StackPanel><Button HorizontalAlignment="Right" Command="{Binding ClearLogCommand}" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="4"><StackPanel Orientation="Horizontal"><local:IconView Kind="trash" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="清空日志" FontSize="12"/></StackPanel></Button><TextBox x:Name="LogBox" Grid.Row="1" Text="{Binding Logs,Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Background="#F1F6FD" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Foreground="#617A9E" Padding="8,4" TextChanged="LogChanged"/></Grid></Border>
<ProgressBar IsIndeterminate="{Binding Busy}" Height="4" Margin="0,5,0,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Blue}"/>
</StackPanel></ScrollViewer>
</Grid></Window>
