<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>WuWaFpsUnlock</AssemblyName><RootNamespace>WuWaFpsUnlock</RootNamespace>
    <Version>1.2.0-RC</Version><AssemblyVersion>1.2.0.0</AssemblyVersion><FileVersion>1.2.0.0</FileVersion><InformationalVersion>1.2.0RC</InformationalVersion>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><PublishTrimmed>false</PublishTrimmed><PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup><ItemGroup><ProjectReference Include="..\WuWaFpsUnlock.Core\WuWaFpsUnlock.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Cover.original.png" /><Resource Include="Assets\Icon.original.jpg" /><Resource Include="Assets\Icon.transparent.png" /><Resource Include="Assets\App.ico" />
    <Compile Remove="Services\ExternalUnlockerService.cs;Services\ExternalLaunchWorker.cs" />
    <Content Include="..\..\components\ww_plugin_base.dll" Link="components\fps\ww_plugin_base.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\components\PROVENANCE.json" Link="components\PROVENANCE.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <PropertyGroup>
    <EmbeddedUpdaterDirectory>$(MSBuildProjectDirectory)\obj\embedded-updater\$(Configuration)\</EmbeddedUpdaterDirectory>
    <UpdaterDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</UpdaterDotNetHost>
    <UpdaterDotNetHost Condition="'$(UpdaterDotNetHost)' == ''">dotnet</UpdaterDotNetHost>
  </PropertyGroup>
  <ItemGroup>
    <UpdaterBuildInputs Include="$(MSBuildProjectDirectory)\..\..\tools\OfflineUpdater\*.cs;$(MSBuildProjectDirectory)\..\..\tools\OfflineUpdater\*.csproj;$(MSBuildProjectDirectory)\..\WuWaFpsUnlock.Core\UpdatePackageProtocol.cs" />
    <EmbeddedResource Include="$(EmbeddedUpdaterDirectory)WuWaUpdater.exe" LogicalName="WuWaFpsUnlock.RollbackWorker.exe" />
  </ItemGroup>
  <Target Name="BuildEmbeddedRollbackWorker" BeforeTargets="PrepareResources" Inputs="@(UpdaterBuildInputs)" Outputs="$(EmbeddedUpdaterDirectory)WuWaUpdater.exe" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(UpdaterDotNetHost)&quot; publish &quot;$(MSBuildProjectDirectory)\..\..\tools\OfflineUpdater\OfflineUpdater.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -o &quot;$(EmbeddedUpdaterDirectory).&quot;" />
  </Target>
</Project>
