<Window x:Class="WuWaFpsUnlock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WuWaFpsUnlock.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="鸣潮 FPS Unlock" Width="490" Height="370" MinWidth="490" MinHeight="370" Style="{StaticResource WindowFrame}" WindowStyle="None" ResizeMode="CanResize" Icon="Assets/App.ico" WindowStartupLocation="CenterScreen">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Background="#F7FAFF"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" Margin="14,0,0,0"><Image Source="{StaticResource TitleAvatar}" Width="23" Height="23" Stretch="Uniform"/><TextBlock Text="鸣潮 FPS Unlock" FontWeight="SemiBold" Margin="8,0,0,0"/><TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="最小化"><local:IconView Kind="minus" Width="17" Height="17"/></Button><Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="最大化"><local:IconView Kind="max" Width="16" Height="16"/></Button><Button Style="{StaticResource CaptionButton}" Click="Close_Click" AutomationProperties.Name="关闭"><local:IconView Kind="close" Width="18" Height="18"/></Button></StackPanel>
</Grid>
<Grid Grid.Row="1" Margin="14,8,14,12"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="48"/></Grid.RowDefinitions>
<local:HeroBanner Height="82" Compact="True" ShowVersion="False"/>
<local:FpsCard Grid.Row="2"/>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Button Command="{Binding OpenSettingsCommand}" FontSize="16"><StackPanel Orientation="Horizontal"><local:IconView Kind="settings" Width="23" Height="23" Margin="0,0,10,0"/><TextBlock Text="设置"/></StackPanel></Button>
<ComboBox x:Name="ResourceTierSelector" DropDownOpened="ResourceTier_Opened" DropDownClosed="ResourceTier_Closed" Grid.Column="2" SelectedIndex="{Binding ResourceTierIndex}" IsEnabled="{Binding CanChangeFpsMode}" VerticalContentAlignment="Center" FontSize="14" ToolTip="包体档位：下次启动生效；所选档位资源需在官方启动器下载" AutomationProperties.Name="包体档位">
<ComboBox.Template>
<ControlTemplate TargetType="ComboBox">
<Grid>
<ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
<ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
<Border x:Name="TierBorder" Background="#EEF4FC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7">
<Grid Margin="8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
<TextBlock Text="包体档位" FontSize="15" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="#47618B" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
</Grid></Border>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TierBorder" Property="Background" Value="#E3EDFA"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="TierBorder" Property="Background" Value="#D8E5F6"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></ToggleButton.Template>
</ToggleButton>
<Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
<Border Background="#FAFCFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" Margin="0,4,0,0">
<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
</Border></Popup>
</Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate>
</ComboBox.Template>
<ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="6,5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E3EDFA"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E3EDFA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ComboBox.ItemContainerStyle>
<ComboBoxItem><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="极致"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding UhdTier.Color}"/><TextBlock Grid.Column="2" Text="{Binding UhdTier.StatusText}" FontSize="12" Margin="4,0,0,0" Foreground="{StaticResource Muted}"/></Grid></ComboBoxItem>
<ComboBoxItem><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="高清"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding HdTier.Color}"/><TextBlock Grid.Column="2" Text="{Binding HdTier.StatusText}" FontSize="12" Margin="4,0,0,0" Foreground="{StaticResource Muted}"/></Grid></ComboBoxItem>
<ComboBoxItem><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="流畅"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding SdTier.Color}"/><TextBlock Grid.Column="2" Text="{Binding SdTier.StatusText}" FontSize="12" Margin="4,0,0,0" Foreground="{StaticResource Muted}"/></Grid></ComboBoxItem>
</ComboBox>
<Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" FontSize="17"><StackPanel Orientation="Horizontal"><local:IconView Kind="play" Width="22" Height="22" Stroke="White" Margin="0,0,12,0"/><TextBlock Text="{Binding StartLabel}"/></StackPanel></Button>
</Grid>

</Grid></Grid></Window>








