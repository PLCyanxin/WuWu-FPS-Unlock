<Window x:Class="WuWaFpsUnlock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WuWaFpsUnlock.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="鸣潮 FPS Unlock" Width="590" Height="444" MinWidth="550" MinHeight="430" Style="{StaticResource WindowFrame}" WindowStyle="None" ResizeMode="CanResize" Icon="Assets/App.ico" WindowStartupLocation="CenterScreen">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Background="#F7FAFF"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" Margin="14,0,0,0"><Image Source="Assets/Icon.original.jpg" Width="23" Height="23" Stretch="Uniform"/><TextBlock Text="鸣潮 FPS Unlock" FontWeight="SemiBold" Margin="8,0,0,0"/><TextBlock Text="v0.1" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="最小化"><local:IconView Kind="minus" Width="17" Height="17"/></Button><Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="最大化"><local:IconView Kind="max" Width="16" Height="16"/></Button><Button Style="{StaticResource CaptionButton}" Click="Close_Click" AutomationProperties.Name="关闭"><local:IconView Kind="close" Width="18" Height="18"/></Button></StackPanel>
</Grid>
<Grid Grid.Row="1" Margin="14,8,14,12"><Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="50"/><RowDefinition Height="25"/></Grid.RowDefinitions>
<local:HeroBanner Height="94"/>
<local:FpsCard Grid.Row="2"/>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="272"/></Grid.ColumnDefinitions>
<Button Command="{Binding OpenSettingsCommand}" FontSize="17"><StackPanel Orientation="Horizontal"><local:IconView Kind="settings" Width="23" Height="23" Margin="0,0,10,0"/><TextBlock Text="设置"/></StackPanel></Button>
<Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" FontSize="18"><StackPanel Orientation="Horizontal"><local:IconView Kind="play" Width="22" Height="22" Stroke="White" Margin="0,0,12,0"/><TextBlock Text="{Binding StartLabel}"/></StackPanel></Button>
</Grid>
<TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="1,7,0,0"/>
</Grid></Grid></Window>

