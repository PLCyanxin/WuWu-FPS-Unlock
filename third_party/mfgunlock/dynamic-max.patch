+namespace mfgunlock::dynamicmax {
+using GetProcFn = FARPROC(WINAPI*)(HMODULE, LPCSTR);
+using QueryFn = void*(__cdecl*)(std::uint32_t);
+using GetterFn = int(__cdecl*)(void*, void*, std::uint32_t, Setting*);
+using GatewayFn = void*(*)(const char*);
+inline std::atomic<int> g_configured{0}, g_effective{0};
+inline std::atomic<bool> g_armed{false}, g_wrapped{false}, g_observed{false}, g_answered{false};
+inline std::atomic<QueryFn> g_query{nullptr};
+inline std::atomic<GetterFn> g_getter{nullptr};
+inline GetProcFn g_get_proc = nullptr;
+inline thread_local bool g_identifying = false;
+
+inline void Log(const char* text) { reshade::log::message(reshade::log::level::info, text); }
+inline HMODULE ModuleAt(const void* address) {
+  HMODULE module = nullptr;
+  if (!address || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+      GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, reinterpret_cast<LPCWSTR>(address), &module)) return nullptr;
+  return module;
+}
+inline bool InModule(void* function, HMODULE module) { return function && ModuleAt(function) == module; }
+inline bool HasPluginRole(GatewayFn gateway, HMODULE module) {
+  // A renamed module with an unrelated/broken gateway must not crash the caller.
+  // No C++ objects requiring unwind exist in this SEH boundary.
+  __try {
+    if (InModule(gateway("slDLSSGSetOptions"), module) && InModule(gateway("slDLSSGGetState"), module)) return true;
+    return InModule(gateway("slSetConstants"), module) && InModule(gateway("slEvaluateFeature"), module) &&
+           InModule(gateway("slSetTag"), module);
+  } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+// Gateway queries only: never invoke slOnPluginLoad or initialize a foreign plugin.
+// A generic slGetPluginFunction export is insufficient (SR/Reflex also expose it).
+inline bool IsConsumer(const void* caller) {
+  if (!g_get_proc || g_identifying) return false;
+  HMODULE module = ModuleAt(caller);
+  if (!module || module == ModuleAt(reinterpret_cast<void*>(&IsConsumer))) return false;
+  g_identifying = true;
+  struct Reset { ~Reset() { g_identifying = false; } } reset;
+  auto gateway = reinterpret_cast<GatewayFn>(g_get_proc(module, "slGetPluginFunction"));
+  if (gateway && InModule(reinterpret_cast<void*>(gateway), module)) {
+    return HasPluginRole(gateway, module); // Reject other Streamline features, including OTA-renamed ones.
+  }
+  wchar_t path[32768];
+  DWORD count = GetModuleFileNameW(module, path, 32768);
+  if (!count || count >= 32768) return false;
+  const wchar_t* base = std::wcsrchr(path, L'\\'); base = base ? base + 1 : path;
+  if (_wcsicmp(base, L"sl.interposer.dll") == 0)
+    return InModule(reinterpret_cast<void*>(g_get_proc(module, "slInit")), module) &&
+           InModule(reinterpret_cast<void*>(g_get_proc(module, "slGetFeatureFunction")), module);
+  if (_wcsicmp(base, L"nvngx_dlssg.dll") == 0)
+    return InModule(reinterpret_cast<void*>(g_get_proc(module, "NVSDK_NGX_D3D12_PopulateDeviceParameters_Impl")), module);
+  return false;
+}
