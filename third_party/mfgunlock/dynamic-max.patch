+      std::ostringstream message;
+      message << "mfgunlock: answered Dynamic MFG maximum DRS key 0x10562D0F with "
+              << setting->u32CurrentValue << " (" << setting->u32CurrentValue + 1 << "x); native use still requires runtime verification.";
+      Log(message.str().c_str());
+    }
+  } else {
+    static std::atomic_bool logged{false};
+    if (!logged.exchange(true)) Log("mfgunlock: Dynamic maximum override unavailable; preserving NVIDIA/driver behavior (getter status or ABI/type check failed).");
+  }
+  return result;
+}
+__declspec(noinline) inline void* __cdecl WrappedQuery(std::uint32_t id) {
+  const void* caller = _ReturnAddress();
+  auto real = g_query.load(std::memory_order_acquire);
+  if (!real) return nullptr;
+  void* result = real(id);
+  if (id != kGetSettingId || !result || !g_armed.load(std::memory_order_acquire) || !IsConsumer(caller)) return result;
+  auto getter = reinterpret_cast<GetterFn>(result);
+  GetterFn expected = nullptr;
+  if (!g_getter.compare_exchange_strong(expected, getter) && expected != getter) return result;
+  if (!g_wrapped.exchange(true)) {
+    char path[32768]{};
+    GetModuleFileNameA(ModuleAt(caller), path, 32768);
+    std::ostringstream message;
+    message << "mfgunlock: wrapped NvAPI_DRS_GetSetting for Streamline DRS consumer " << path;
+    Log(message.str().c_str());
+  }
+  return reinterpret_cast<void*>(&WrappedGetSetting);
+}
+inline FARPROC OverrideProc(HMODULE module, LPCSTR name, FARPROC result, const void* caller) {
+  if (!g_armed.load(std::memory_order_acquire) || !result || reinterpret_cast<ULONG_PTR>(name) <= 0xffff ||
+      std::strcmp(name, "nvapi_QueryInterface") != 0 || module != GetModuleHandleW(L"nvapi64.dll") || !IsConsumer(caller)) return result;
+  auto query = reinterpret_cast<QueryFn>(result);
+  QueryFn expected = nullptr;
+  if (!g_query.compare_exchange_strong(expected, query) && expected != query) return result;
+  return reinterpret_cast<FARPROC>(&WrappedQuery);
+}
+inline bool Freeze(bool enabled, bool dynamic) {
+  int cap = enabled && dynamic ? Normalize(g_configured.load()) : 0;
+  g_effective.store(cap);
+  if (!cap) return false;
+  // Consumers cache returned function pointers. Keep this module mapped for the
+  // process lifetime so unloading an overlay cannot leave dangling NVAPI callbacks.
+  HMODULE self = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+      reinterpret_cast<LPCWSTR>(&Freeze), &self)) {
+    g_effective.store(0); Log("mfgunlock: Dynamic maximum override unavailable; could not retain callback module."); return false;
+  }
+  std::ostringstream message;
+  message << "mfgunlock: Dynamic maximum configured: " << cap << "x (DRS value " << DriverValue(cap)
+          << "); startup configuration frozen; requires full game restart after changes.";
+  Log(message.str().c_str());
+  if (GetModuleHandleW(L"sl.common.dll") || GetModuleHandleW(L"sl.dlss_g.dll"))
+    Log("mfgunlock: Streamline was already mapped; cached DRS getters may predate this override. No cap is claimed until the DRS read is observed.");
+  return true;
+}
+} // namespace mfgunlock::dynamicmax
