diff --git a/src/addons/mfgunlock/dynamicmax.hpp b/src/addons/mfgunlock/dynamicmax.hpp
new file mode 100644
index 0000000..b33e58c
--- /dev/null
+++ b/src/addons/mfgunlock/dynamicmax.hpp
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: MIT
+// Process-local DRS read override. Never patches NVAPI code or writes driver profiles.
+#pragma once
+#include <windows.h>
+#include <intrin.h>
+#include <atomic>
+#include <cstring>
+#include <cwchar>
+#include <sstream>
+#include <include/reshade.hpp>
+#include "dynamicmax_policy.hpp"
+
+namespace mfgunlock::dynamicmax {
+using GetProcFn = FARPROC(WINAPI*)(HMODULE, LPCSTR);
+using QueryFn = void*(__cdecl*)(std::uint32_t);
+using GetterFn = int(__cdecl*)(void*, void*, std::uint32_t, Setting*);
+using GatewayFn = void*(*)(const char*);
+inline std::atomic<int> g_configured{0}, g_effective{0};
+inline std::atomic<bool> g_armed{false}, g_wrapped{false}, g_observed{false}, g_answered{false};
+inline std::atomic<QueryFn> g_query{nullptr};
+inline std::atomic<GetterFn> g_getter{nullptr};
+inline GetProcFn g_get_proc = nullptr;
+inline thread_local bool g_identifying = false;
+
+inline void Log(const char* text) { reshade::log::message(reshade::log::level::info, text); }
+inline HMODULE ModuleAt(const void* address) {
+  HMODULE module = nullptr;
+  if (!address || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+      GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, reinterpret_cast<LPCWSTR>(address), &module)) return nullptr;
+  return module;
+}
+inline bool InModule(void* function, HMODULE module) { return function && ModuleAt(function) == module; }
+inline bool HasPluginRole(GatewayFn gateway, HMODULE module) {
+  // A renamed module with an unrelated/broken gateway must not crash the caller.
+  // No C++ objects requiring unwind exist in this SEH boundary.
+  __try {
+    if (InModule(gateway("slDLSSGSetOptions"), module) && InModule(gateway("slDLSSGGetState"), module)) return true;
+    return InModule(gateway("slSetConstants"), module) && InModule(gateway("slEvaluateFeature"), module) &&
+           InModule(gateway("slSetTag"), module);
+  } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+// Gateway queries only: never invoke slOnPluginLoad or initialize a foreign plugin.
+// A generic slGetPluginFunction export is insufficient (SR/Reflex also expose it).
+inline bool IsConsumer(const void* caller) {
+  if (!g_get_proc || g_identifying) return false;
+  HMODULE module = ModuleAt(caller);
+  if (!module || module == ModuleAt(reinterpret_cast<void*>(&IsConsumer))) return false;
+  g_identifying = true;
+  struct Reset { ~Reset() { g_identifying = false; } } reset;
+  auto gateway = reinterpret_cast<GatewayFn>(g_get_proc(module, "slGetPluginFunction"));
+  if (gateway && InModule(reinterpret_cast<void*>(gateway), module)) {
+    return HasPluginRole(gateway, module); // Reject other Streamline features, including OTA-renamed ones.
+  }
+  wchar_t path[32768];
+  DWORD count = GetModuleFileNameW(module, path, 32768);
+  if (!count || count >= 32768) return false;
+  const wchar_t* base = std::wcsrchr(path, L'\\'); base = base ? base + 1 : path;
+  if (_wcsicmp(base, L"sl.interposer.dll") == 0)
+    return InModule(reinterpret_cast<void*>(g_get_proc(module, "slInit")), module) &&
+           InModule(reinterpret_cast<void*>(g_get_proc(module, "slGetFeatureFunction")), module);
+  if (_wcsicmp(base, L"nvngx_dlssg.dll") == 0)
+    return InModule(reinterpret_cast<void*>(g_get_proc(module, "NVSDK_NGX_D3D12_PopulateDeviceParameters_Impl")), module);
+  return false;
+}
+__declspec(noinline) inline int __cdecl WrappedGetSetting(void* session, void* profile,
+                                                         std::uint32_t id, Setting* setting) {
+  const void* caller = _ReturnAddress();
+  auto real = g_getter.load(std::memory_order_acquire);
+  if (!real) return -3; // Unreachable after a successful wrapper publication.
+  const bool known = setting && setting->version == kSettingVersion;
+  const int result = real(session, profile, id, setting);
+  if (!g_armed.load(std::memory_order_acquire) || id != kSettingId || !IsConsumer(caller)) return result;
+  g_observed.store(true, std::memory_order_relaxed);
+  if (Apply(result, id, setting, g_effective.load(std::memory_order_relaxed), true, known)) {
+    if (!g_answered.exchange(true)) {
+      std::ostringstream message;
+      message << "mfgunlock: answered Dynamic MFG maximum DRS key 0x10562D0F with "
+              << setting->u32CurrentValue << " (" << setting->u32CurrentValue + 1 << "x); native use still requires runtime verification.";
+      Log(message.str().c_str());
+    }
+  } else {
+    static std::atomic_bool logged{false};
+    if (!logged.exchange(true)) Log("mfgunlock: Dynamic maximum override unavailable; preserving NVIDIA/driver behavior (getter status or ABI/type check failed).");
+  }
+  return result;
+}
+__declspec(noinline) inline void* __cdecl WrappedQuery(std::uint32_t id) {
+  const void* caller = _ReturnAddress();
+  auto real = g_query.load(std::memory_order_acquire);
+  if (!real) return nullptr;
+  void* result = real(id);
+  if (id != kGetSettingId || !result || !g_armed.load(std::memory_order_acquire) || !IsConsumer(caller)) return result;
+  auto getter = reinterpret_cast<GetterFn>(result);
+  GetterFn expected = nullptr;
+  if (!g_getter.compare_exchange_strong(expected, getter) && expected != getter) return result;
+  if (!g_wrapped.exchange(true)) {
+    char path[32768]{};
+    GetModuleFileNameA(ModuleAt(caller), path, 32768);
+    std::ostringstream message;
+    message << "mfgunlock: wrapped NvAPI_DRS_GetSetting for Streamline DRS consumer " << path;
+    Log(message.str().c_str());
+  }
+  return reinterpret_cast<void*>(&WrappedGetSetting);
+}
+inline FARPROC OverrideProc(HMODULE module, LPCSTR name, FARPROC result, const void* caller) {
+  if (!g_armed.load(std::memory_order_acquire) || !result || reinterpret_cast<ULONG_PTR>(name) <= 0xffff ||
+      std::strcmp(name, "nvapi_QueryInterface") != 0 || module != GetModuleHandleW(L"nvapi64.dll") || !IsConsumer(caller)) return result;
+  auto query = reinterpret_cast<QueryFn>(result);
+  QueryFn expected = nullptr;
+  if (!g_query.compare_exchange_strong(expected, query) && expected != query) return result;
+  return reinterpret_cast<FARPROC>(&WrappedQuery);
+}
+inline bool Freeze(bool enabled, bool dynamic) {
+  int cap = enabled && dynamic ? Normalize(g_configured.load()) : 0;
+  g_effective.store(cap);
+  if (!cap) return false;
+  // Consumers cache returned function pointers. Keep this module mapped for the
+  // process lifetime so unloading an overlay cannot leave dangling NVAPI callbacks.
+  HMODULE self = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+      reinterpret_cast<LPCWSTR>(&Freeze), &self)) {
+    g_effective.store(0); Log("mfgunlock: Dynamic maximum override unavailable; could not retain callback module."); return false;
+  }
+  std::ostringstream message;
+  message << "mfgunlock: Dynamic maximum configured: " << cap << "x (DRS value " << DriverValue(cap)
+          << "); startup configuration frozen; requires full game restart after changes.";
+  Log(message.str().c_str());
+  if (GetModuleHandleW(L"sl.common.dll") || GetModuleHandleW(L"sl.dlss_g.dll"))
+    Log("mfgunlock: Streamline was already mapped; cached DRS getters may predate this override. No cap is claimed until the DRS read is observed.");
+  return true;
+}
+} // namespace mfgunlock::dynamicmax
