new file mode 100644
index 0000000..5d1ea02
--- /dev/null
+++ b/src/addons/mfgunlock/dynamicmax_policy.hpp
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: MIT
+// Minimal NVAPI DRS V1 ABI, audited against NVIDIA/nvapi 70d337db9186e968eab622f7e786de7e437faf3d.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace mfgunlock::dynamicmax {
+constexpr std::uint32_t kSettingId = 0x10562D0F;
+constexpr std::uint32_t kGetSettingId = 0x73BF8338;
+#pragma pack(push, 4)
+struct Setting {
+  std::uint32_t version;
+  std::uint16_t settingName[2048];
+  std::uint32_t settingId, settingType, settingLocation;
+  std::uint32_t isCurrentPredefined, isPredefinedValid;
+  union { std::uint32_t u32PredefinedValue; std::uint8_t predefinedStorage[4100]; };
+  union { std::uint32_t u32CurrentValue; std::uint8_t currentStorage[4100]; };
+};
+#pragma pack(pop)
+constexpr std::uint32_t kSettingVersion = 0x13020;
+static_assert(sizeof(Setting) == 0x3020);
+static_assert(alignof(Setting) == 4);
+static_assert(offsetof(Setting, settingId) == 0x1004);
+static_assert(offsetof(Setting, settingType) == 0x1008);
+static_assert(offsetof(Setting, settingLocation) == 0x100c);
+static_assert(offsetof(Setting, isCurrentPredefined) == 0x1010);
+static_assert(offsetof(Setting, isPredefinedValid) == 0x1014);
+static_assert(offsetof(Setting, u32PredefinedValue) == 0x1018);
+static_assert(offsetof(Setting, u32CurrentValue) == 0x201c);
+constexpr int Normalize(int cap) { return cap >= 2 && cap <= 6 ? cap : 0; }
+constexpr int ParseConfig(std::string_view value) {
+  while (!value.empty() && (value.front() == ' ' || value.front() == '\t')) value.remove_prefix(1);
+  while (!value.empty() && (value.back() == ' ' || value.back() == '\t')) value.remove_suffix(1);
+  return value.size() == 1 && value[0] >= '2' && value[0] <= '6' ? value[0] - '0' : 0;
+}
+constexpr std::uint32_t DriverValue(int cap) { return Normalize(cap) == 0 ? 0 : static_cast<std::uint32_t>(cap - 1); }
+// Only known successful DWORD results can be changed. Never manufacture NVAPI_OK
+// for an invalid session, missing key, unsupported driver, or unknown ABI.
+inline bool Apply(int status, std::uint32_t id, Setting* setting, int cap,
+                  bool consumer, bool known_request) {
+  if (status != 0 || id != kSettingId || !setting || !consumer || !known_request ||
+      Normalize(cap) == 0 || setting->version != kSettingVersion ||
+      setting->settingId != kSettingId || setting->settingType != 0) return false;
+  setting->u32CurrentValue = DriverValue(cap);
+  setting->settingLocation = 0; // NVDRS_CURRENT_PROFILE_LOCATION: NoGlobal consumer requires it.
+  setting->isCurrentPredefined = 0;
+  return true;
+}
+} // namespace mfgunlock::dynamicmax
