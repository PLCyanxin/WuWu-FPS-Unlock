+ if(!configure)throw std::runtime_error("not our inert NVAPI fixture");
+ auto queries=reinterpret_cast<unsigned(*)()>(GetProcAddress(nvapi,"FixtureQueries"));
+ using Read=int(*)(HMODULE,unsigned,dynamicmax::Setting*);
+ auto getread=[](HMODULE module){return reinterpret_cast<Read>(GetProcAddress(module,"FixtureRead"));};
+ auto early=getread(load(L"early-common.dll"));
+ unsigned passed=0;
+ auto check=[&](bool ok,const char* name){if(!ok)throw std::runtime_error(name);std::cout<<"PASS "<<name<<"\n";++passed;};
+ auto fresh=[](){dynamicmax::Setting s{};s.version=dynamicmax::kSettingVersion;return s;};
+ auto s=fresh();early(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"pre-hook cache retains real getter");
+ loadhook::g_on_dlssg_loaded=+[](HMODULE){};
+ loadhook::TryInstall();check(loadhook::g_hooked.load(),"production loader hooks enabled with inert callback" );
