+    internal::g_dynamic_hooked.store(true);
+    dynamicmax::Log("mfgunlock: Dynamic maximum DRS read interception armed; no runtime use claimed until a matching read is observed.");
+  } else {
+    dynamicmax::Log("mfgunlock: Dynamic maximum override unavailable; preserving NVIDIA/driver behavior (GetProcAddress interception unavailable).");
+  }
+}
+
