+#ifndef FIXTURE_ROLE
+#define FIXTURE_ROLE 0
+#endif
+using Setting=mfgunlock::dynamicmax::Setting;
+using Query=void*(__cdecl*)(unsigned);
+using Getter=int(__cdecl*)(void*,void*,unsigned,Setting*);
+static Getter cached=nullptr;static Query query=nullptr;static volatile unsigned completed=0;
+static void RoleMarker() {}
+extern "C" __declspec(dllexport) void* slGetPluginFunction(const char* name) {
+ bool match=false;
+ if(FIXTURE_ROLE==1||FIXTURE_ROLE==3)match=!std::strcmp(name,"slSetConstants")||!std::strcmp(name,"slEvaluateFeature")||!std::strcmp(name,"slSetTag");
+ if(FIXTURE_ROLE==2)match=!std::strcmp(name,"slDLSSGSetOptions")||!std::strcmp(name,"slDLSSGGetState");
+ if(!match)return nullptr;
+ if(FIXTURE_ROLE==3)return reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"),"GetCurrentProcessId"));
+ return reinterpret_cast<void*>(&RoleMarker);
+}
+extern "C" __declspec(dllexport) int FixtureRead(HMODULE nvapi,unsigned id,Setting* value) {
+ if(!cached){query=reinterpret_cast<Query>(GetProcAddress(nvapi,"nvapi_QueryInterface"));if(!query)return -3;cached=reinterpret_cast<Getter>(query(mfgunlock::dynamicmax::kGetSettingId));}
+ if(!cached)return -3;
+ int result=cached(nullptr,nullptr,id,value);completed=completed+1;return result;
+}
+extern "C" __declspec(dllexport) void* FixtureCachedGetter() { return reinterpret_cast<void*>(cached); }
+extern "C" __declspec(dllexport) void* FixtureCachedQuery() { return reinterpret_cast<void*>(query); }
