diff --git a/tests/dynamicmax_fixtures/consumer_fixture.cpp b/tests/dynamicmax_fixtures/consumer_fixture.cpp
new file mode 100644
index 0000000..1aa4dcd
--- /dev/null
+++ b/tests/dynamicmax_fixtures/consumer_fixture.cpp
@@ -0,0 +1,27 @@
+// Compile this source several times with FIXTURE_ROLE=0/1/2/3.
+#include <windows.h>
+#include <cstring>
+#include "../../src/addons/mfgunlock/dynamicmax_policy.hpp"
+#ifndef FIXTURE_ROLE
+#define FIXTURE_ROLE 0
+#endif
+using Setting=mfgunlock::dynamicmax::Setting;
+using Query=void*(__cdecl*)(unsigned);
+using Getter=int(__cdecl*)(void*,void*,unsigned,Setting*);
+static Getter cached=nullptr;static Query query=nullptr;static volatile unsigned completed=0;
+static void RoleMarker() {}
+extern "C" __declspec(dllexport) void* slGetPluginFunction(const char* name) {
+ bool match=false;
+ if(FIXTURE_ROLE==1||FIXTURE_ROLE==3)match=!std::strcmp(name,"slSetConstants")||!std::strcmp(name,"slEvaluateFeature")||!std::strcmp(name,"slSetTag");
+ if(FIXTURE_ROLE==2)match=!std::strcmp(name,"slDLSSGSetOptions")||!std::strcmp(name,"slDLSSGGetState");
+ if(!match)return nullptr;
+ if(FIXTURE_ROLE==3)return reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"),"GetCurrentProcessId"));
+ return reinterpret_cast<void*>(&RoleMarker);
+}
+extern "C" __declspec(dllexport) int FixtureRead(HMODULE nvapi,unsigned id,Setting* value) {
+ if(!cached){query=reinterpret_cast<Query>(GetProcAddress(nvapi,"nvapi_QueryInterface"));if(!query)return -3;cached=reinterpret_cast<Getter>(query(mfgunlock::dynamicmax::kGetSettingId));}
+ if(!cached)return -3;
+ int result=cached(nullptr,nullptr,id,value);completed=completed+1;return result;
+}
+extern "C" __declspec(dllexport) void* FixtureCachedGetter() { return reinterpret_cast<void*>(cached); }
+extern "C" __declspec(dllexport) void* FixtureCachedQuery() { return reinterpret_cast<void*>(query); }
diff --git a/tests/dynamicmax_fixtures/nvapi_fixture.cpp b/tests/dynamicmax_fixtures/nvapi_fixture.cpp
new file mode 100644
index 0000000..cdc2fb1
--- /dev/null
+++ b/tests/dynamicmax_fixtures/nvapi_fixture.cpp
@@ -0,0 +1,21 @@
+// Test DLL only. Never links to or calls the system NVIDIA API.
+#include <windows.h>
+#include "../../src/addons/mfgunlock/dynamicmax_policy.hpp"
+using mfgunlock::dynamicmax::Setting;
+static int result_code=0;
+static unsigned calls=0,queries=0;
+extern "C" __declspec(dllexport) void FixtureConfigure(int result) { result_code=result; }
+extern "C" __declspec(dllexport) unsigned FixtureCalls() { return calls; }
+extern "C" __declspec(dllexport) unsigned FixtureQueries() { return queries; }
+extern "C" __declspec(dllexport) int __cdecl FixtureGetter(void*,void*,unsigned id,Setting* value) {
+ ++calls;
+ if(result_code)return result_code;
+ if(!value)return -5;
+ value->settingId=id;value->settingType=0;value->settingLocation=2;
+ value->isCurrentPredefined=1;value->isPredefinedValid=1;
+ value->u32PredefinedValue=5;value->u32CurrentValue=5;
+ return 0;
+}
+extern "C" __declspec(dllexport) void* __cdecl nvapi_QueryInterface(unsigned id) {
+ ++queries;return id==mfgunlock::dynamicmax::kGetSettingId?reinterpret_cast<void*>(&FixtureGetter):nullptr;
+}
diff --git a/tests/dynamicmax_hook_tests.cpp b/tests/dynamicmax_hook_tests.cpp
new file mode 100644
index 0000000..2a47783
--- /dev/null
+++ b/tests/dynamicmax_hook_tests.cpp
@@ -0,0 +1,48 @@
+// Isolated native integration test: real production GPA hook with self-built fixture DLLs.
+// Refuses to run if NVIDIA NVAPI is already loaded. Never loads any real game/driver DLL.
+#include <windows.h>
+#include <iostream>
+#include <filesystem>
+#include <stdexcept>
+#include "../src/addons/mfgunlock/loadhook.hpp"
+using namespace mfgunlock;
+extern "C" __declspec(dllexport) void ReShadeLogMessage(void*, int, const char* message) { std::cout << message << std::endl; }
+int wmain(int argc,wchar_t** argv) {
+ std::cout.setf(std::ios::unitbuf);
+ reshade::internal::get_reshade_module_handle(GetModuleHandleW(nullptr));
+ if(argc!=2)throw std::runtime_error("Pass isolated fixture directory");
+ if(GetModuleHandleW(L"nvapi64.dll"))throw std::runtime_error("NVAPI already present; refusing test");
+ std::filesystem::path root=std::filesystem::absolute(argv[1]);
+ auto load=[&](const wchar_t* file){auto mod=LoadLibraryExW((root/file).c_str(),nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);if(!mod)throw std::runtime_error("fixture load failed");return mod;};
+ HMODULE nvapi=load(L"nvapi64.dll");
+ auto configure=reinterpret_cast<void(*)(int)>(GetProcAddress(nvapi,"FixtureConfigure"));
+ if(!configure)throw std::runtime_error("not our inert NVAPI fixture");
+ auto queries=reinterpret_cast<unsigned(*)()>(GetProcAddress(nvapi,"FixtureQueries"));
+ using Read=int(*)(HMODULE,unsigned,dynamicmax::Setting*);
+ auto getread=[](HMODULE module){return reinterpret_cast<Read>(GetProcAddress(module,"FixtureRead"));};
+ auto early=getread(load(L"early-common.dll"));
+ unsigned passed=0;
+ auto check=[&](bool ok,const char* name){if(!ok)throw std::runtime_error(name);std::cout<<"PASS "<<name<<"\n";++passed;};
+ auto fresh=[](){dynamicmax::Setting s{};s.version=dynamicmax::kSettingVersion;return s;};
+ auto s=fresh();early(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"pre-hook cache retains real getter");
+ dynamicmax::g_configured.store(0);check(!dynamicmax::Freeze(true,true),"cap zero does not request arm");loadhook::TryInstallDynamicMaximum();check(!loadhook::internal::g_dynamic_hooked.load(),"cap zero installs no GPA interception");
+ dynamicmax::g_configured.store(4);check(!dynamicmax::Freeze(true,false),"fixed mode does not arm");
+ check(dynamicmax::Freeze(true,true),"valid Dynamic startup frozen");loadhook::TryInstallDynamicMaximum();check(dynamicmax::g_armed.load(),"real production Detours GPA hook armed");
+ HMODULE common=load(L"a19b836f.bin");auto read=getread(common);s=fresh();unsigned before=queries();
+ check(read(nvapi,dynamicmax::kSettingId,&s)==0&&s.u32CurrentValue==3&&s.settingLocation==0,"content-addressed common consumer receives 4x ceiling");
+ check(queries()==before+1&&dynamicmax::g_wrapped.load()&&dynamicmax::g_answered.load(),"first query wrapped before consumer cache");
+ dynamicmax::g_configured.store(6);s=fresh();read(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==3&&queries()==before+1,"cached wrapper persists and configured edits do not change frozen cap");
+ s=fresh();early(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"late arm cannot rewrite preexisting getter cache");
+ auto unrelated=getread(load(L"unrelated.dll"));s=fresh();unrelated(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"generic plugin export alone is rejected");
+ auto forwarded=getread(load(L"forwarded.dll"));s=fresh();forwarded(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"foreign-module role pointers rejected");
+ auto dlssg=getread(load(L"dlssg-role.bin"));s=fresh();dlssg(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==3,"content-addressed DLSSG role accepted");
+ auto getter=reinterpret_cast<dynamicmax::GetterFn>(reinterpret_cast<void*(*)()>(GetProcAddress(common,"FixtureCachedGetter"))());
+ s=fresh();getter(nullptr,nullptr,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"borrowed getter called by unrelated host rejected");
+ auto query=reinterpret_cast<dynamicmax::QueryFn>(reinterpret_cast<void*(*)()>(GetProcAddress(common,"FixtureCachedQuery"))());
+ check(query(dynamicmax::kGetSettingId)==reinterpret_cast<void*>(GetProcAddress(nvapi,"FixtureGetter")),"borrowed QI called by unrelated host returns original");
+ s=fresh();s.version+=0x10000;read(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"unknown ABI result passthrough");
+ s=fresh();read(nvapi,123,&s);check(s.u32CurrentValue==5&&s.settingId==123,"other key untouched");
+ for(int status:{-1,-3,-160}){configure(status);s=fresh();auto old=s;check(read(nvapi,dynamicmax::kSettingId,&s)==status&&std::memcmp(&s,&old,sizeof s)==0,"real getter failure fully preserved");}
+ configure(0);loadhook::Uninstall();s=fresh();read(nvapi,dynamicmax::kSettingId,&s);check(s.u32CurrentValue==5,"cached wrapper safe passthrough after disarm");
+ std::cout<<passed<<"/"<<passed<<" native fixture integration assertions passed; no real NVAPI/game DLL loaded.\n";
+}
diff --git a/tests/dynamicmax_policy_tests.cpp b/tests/dynamicmax_policy_tests.cpp
new file mode 100644
index 0000000..b0bc884
--- /dev/null
+++ b/tests/dynamicmax_policy_tests.cpp
@@ -0,0 +1,36 @@
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include "../src/addons/mfgunlock/dynamicmax_policy.hpp"
+using namespace mfgunlock::dynamicmax;
+int main() {
+  unsigned passed = 0;
+  auto check = [&](bool result, const char* label) { if (!result) throw std::runtime_error(label); ++passed; };
+  for (int cap : {0, 1, 7, -1, 999}) check(Normalize(cap) == 0, "invalid cap or no override");
+  for (const char* raw : {"", "broken", "4x", "4.0", "44", "-4", "1", "7", "0", "4 garbage", "999999999999999999999"}) check(ParseConfig(raw) == 0, "corrupt configuration must disable");
+  for (int cap = 2; cap <= 6; ++cap) {
+    check(Normalize(cap) == cap && DriverValue(cap) == static_cast<unsigned>(cap - 1), "generated-frame encoding");
+    Setting value{};value.version=kSettingVersion;value.settingId=kSettingId;value.settingLocation=2;
+    value.isCurrentPredefined=1;value.isPredefinedValid=1;value.u32PredefinedValue=5;value.u32CurrentValue=5;
+    check(Apply(0,kSettingId,&value,cap,true,true),"valid override");
+    check(value.u32CurrentValue==static_cast<unsigned>(cap-1)&&value.settingLocation==0&&value.isCurrentPredefined==0,"current profile DWORD");
+    check(value.u32PredefinedValue==5&&value.isPredefinedValid==1,"retain predefined metadata");
+  }
+  check(ParseConfig(" 4\t")==4,"whitespace configuration");
+  Setting base{};base.version=kSettingVersion;base.settingId=kSettingId;base.u32CurrentValue=5;
+  auto unchanged=[&](int status,unsigned key,int cap,bool consumer,bool known,unsigned version,unsigned type) {
+    Setting value=base;value.version=version;value.settingType=type;Setting before=value;
+    check(!Apply(status,key,&value,cap,consumer,known)&&std::memcmp(&value,&before,sizeof value)==0,"passthrough preserves every byte");
+  };
+  for(int status:{-1,-3,-9,-160})unchanged(status,kSettingId,4,true,true,kSettingVersion,0);
+  unchanged(0,kSettingId+1,4,true,true,kSettingVersion,0);
+  unchanged(0,kSettingId,0,true,true,kSettingVersion,0);
+  unchanged(0,kSettingId,4,false,true,kSettingVersion,0);
+  unchanged(0,kSettingId,4,true,false,kSettingVersion,0);
+  unchanged(0,kSettingId,4,true,true,kSettingVersion+0x10000,0);
+  unchanged(0,kSettingId,4,true,true,kSettingVersion,1);
+  check(!Apply(0,kSettingId,nullptr,4,true,true),"null setting");
+  base.settingId=123;Setting previous=base;
+  check(!Apply(0,kSettingId,&base,4,true,true)&&std::memcmp(&base,&previous,sizeof base)==0,"returned ID mismatch");
+  std::cout << passed << "/" << passed << " pure native ABI/policy assertions passed; no NVAPI, driver, hooking or game execution.\n";
+}
diff --git a/tests/run_dynamicmax_tests.ps1 b/tests/run_dynamicmax_tests.ps1
new file mode 100644
index 0000000..68e122a
--- /dev/null
+++ b/tests/run_dynamicmax_tests.ps1
@@ -0,0 +1,47 @@
+param(
+    [Parameter(Mandatory=$true)][string]$DependencyDirectory,
+    [Parameter(Mandatory=$true)][string]$OutputDirectory,
+    [string]$VcVarsAll
+)
+$ErrorActionPreference = 'Stop'
+$source = Split-Path -Parent $PSScriptRoot
+$deps = (Resolve-Path -LiteralPath $DependencyDirectory).Path
+$out = [IO.Path]::GetFullPath($OutputDirectory)
+if (-not $VcVarsAll) {
+    $vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
+    if (-not (Test-Path -LiteralPath $vswhere)) { throw 'Provide -VcVarsAll; vswhere.exe was not found.' }
+    $installation = & $vswhere -latest -products '*' -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath
+    if (-not $installation) { throw 'MSVC C++ Build Tools were not found.' }
+    $VcVarsAll = Join-Path $installation 'VC\Auxiliary\Build\vcvarsall.bat'
+}
+$vc = (Resolve-Path -LiteralPath $VcVarsAll).Path
+$detours = Join-Path $deps 'external\Detours\lib.X64\detours.lib'
+foreach ($required in @($detours, (Join-Path $deps 'external\Detours\include\detours.h'), (Join-Path $deps 'external\reshade\include\reshade.hpp'))) {
+    if (-not (Test-Path -LiteralPath $required -PathType Leaf)) { throw "Missing prepared dependency: $required" }
+}
+# A fresh directory prevents accidentally loading previously supplied driver DLLs.
+if (Test-Path -LiteralPath $out) {
+    if (Get-ChildItem -LiteralPath $out -Force | Select-Object -First 1) { throw 'OutputDirectory must be empty; use a fresh isolated directory.' }
+} else { New-Item -ItemType Directory -Path $out | Out-Null }
+# These paths are written to a batch script: reject command expansion/metacharacters.
+foreach ($path in @($source,$deps,$out,$vc)) {
+    if ($path -match '[%"!&|<>^\r\n]') { throw 'Build paths cannot contain cmd expansion or control characters.' }
+}
+$flags = '/nologo /std:c++20 /EHsc /MT /O2 /DNDEBUG /DNOMINMAX /utf-8'
+$lines = @('@echo off','setlocal DisableDelayedExpansion', ('call "'+$vc+'" x64'),'if errorlevel 1 exit /b 1',('cd /d "'+$out+'"'))
+$lines += ('cl '+$flags+' "'+$source+'\tests\dynamicmax_policy_tests.cpp" /Fe:dynamicmax_policy_tests.exe')
+$lines += 'if errorlevel 1 exit /b 1','dynamicmax_policy_tests.exe','if errorlevel 1 exit /b 1'
+$lines += ('cl '+$flags+' /LD "'+$source+'\tests\dynamicmax_fixtures\nvapi_fixture.cpp" /link /OUT:nvapi64.dll')
+$lines += 'if errorlevel 1 exit /b 1'
+foreach ($fixture in @(@('early-common.dll',1),@('a19b836f.bin',1),@('unrelated.dll',0),@('forwarded.dll',3),@('dlssg-role.bin',2))) {
+    $lines += ('cl '+$flags+' /LD /DFIXTURE_ROLE='+$fixture[1]+' "'+$source+'\tests\dynamicmax_fixtures\consumer_fixture.cpp" /link /OUT:'+$fixture[0])
+    $lines += 'if errorlevel 1 exit /b 1'
+}
+$lines += ('cl '+$flags+' /bigobj /I"'+$deps+'\external\Detours\include" /I"'+$deps+'\external\reshade" "'+$source+'\tests\dynamicmax_hook_tests.cpp" "'+$detours+'" user32.lib /Fe:dynamicmax_hook_tests.exe')
+$lines += 'if errorlevel 1 exit /b 1',('dynamicmax_hook_tests.exe "'+$out+'"'),'exit /b %errorlevel%'
+$batch = Join-Path $out 'build.cmd'
+# cmd uses the host code page for batch paths, independently of the C++ UTF-8 flag.
+$lines | Set-Content -LiteralPath $batch -Encoding oem
+& $batch 2>&1 | Tee-Object -FilePath (Join-Path $out 'build-test.log')
+if ($LASTEXITCODE -ne 0) { throw "Native fixture build/test failed with exit code $LASTEXITCODE. See $out\build-test.log" }
+Write-Host '49 policy + 21 production-hook fixture assertions passed. No real NVAPI or game was executed.'
